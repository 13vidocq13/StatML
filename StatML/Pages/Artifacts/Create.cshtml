@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Artifacts.CreateModel
@attribute [Authorize(Policy = "AdminOnly")]

<link rel="stylesheet" href="~/css/General.css" />

<h1>Добавить артефакт</h1>
<form method="post">
    <div class="form-group">
        <label asp-for="Artifact.SetId">Комплект</label>
        <select asp-for="Artifact.SetId" asp-items="Model.Sets" class="form-control">
            <option value="">-- Выберите комплект --</option>
        </select>
        <span asp-validation-for="Artifact.SetId" class="text-danger"></span>

        <label asp-for="Artifact.Name">Название</label>
        <input asp-for="Artifact.Name" class="form-control" />
        <span asp-validation-for="Artifact.Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="/Artifacts/Management" class="btn btn-secondary">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}