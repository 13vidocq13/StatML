@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Artifacts.ManagementModel
@attribute [Authorize(Policy = "Everyone")]

<head>
    <link rel="stylesheet" href="~/css/General.css" />
</head>
<body>
    <h1>Управление артефактами</h1>
    
    @if (User.IsInRole("Admin"))
    {
        <p>
            <a asp-page="/Artifacts/Create">Добавить артефакт</a>
        </p>
    }
    <div class="stats-container">
        <div class="card">
            <table class="table">
                <thead>
                    <tr>
                        <th>Назавание</th>
                        <th>Комплект</th>
                        <th>Уровень</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th>Действия</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var artifact in Model.Artifacts.Items)
                    {
                        <tr>
                            <td>@artifact.Name</td>
                            <td>@artifact.SetEntity.Name</td>
                            <td>@artifact.SetEntity.Level</td>
                            @if (User.IsInRole("Admin") || User.IsInRole("TournamentsEditor"))
                            {
                                <td>
                                    <a asp-page="/Artifacts/Edit" asp-route-id="@artifact.Id">Редактировать</a> |
                                    <form method="post" asp-page-handler="Delete" style="display:inline;">
                                        <input type="hidden" name="id" value="@artifact.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Вы уверены, что хотите удалить запись?')">Удалить</button>
                                    </form>
                                </td>
                            }

                        </tr>
                    }
                </tbody>
            </table>
            <div class="pagination">
                @if (Model.Artifacts.HasPreviousPage)
                {
                    <a asp-page="/Artifacts/Management" asp-route-pageIndex="@(Model.Artifacts.PageIndex - 1)" class="btn btn-primary">&laquo; Назад</a>
                }
                else
                {
                    <span class="btn btn-primary disabled">&laquo; Назад</span>
                }

                @for (int i = 1; i <= Model.Artifacts.TotalPages; i++)
                {
                    if (i == Model.Artifacts.PageIndex)
                    {
                        <span class="btn btn-primary disabled">@i</span>
                    }
                    else
                    {
                        <a asp-page="/Artifacts/Management" asp-route-pageIndex="@i" class="btn btn-primary">@i</a>
                    }
                }

                @if (Model.Artifacts.HasNextPage)
                {
                    <a asp-page="/Artifacts/Management" asp-route-pageIndex="@(Model.Artifacts.PageIndex + 1)" class="btn btn-primary">Вперёд &raquo;</a>
                }
                else
                {
                    <span class="btn btn-primary disabled">Вперёд &raquo;</span>
                }
            </div>
        </div>
    </div>
    <p><a asp-page="/Index">Назад</a></p>
</body>
