@page
@model StatML.Pages.EmailNotifications.SaltsModel
<h1>Send Email</h1>

<form method="post">
    <div>
        <label asp-for="RecipientEmail">Recipient Email</label>
        <input asp-for="RecipientEmail" class="form-control" />
        <span asp-validation-for="RecipientEmail" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Subject">Subject</label>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Body">Body</label>
        <textarea asp-for="Body" class="form-control"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Send</button>
</form>

<div class="mt-3">
    <p>@Model.Message</p>
</div>
