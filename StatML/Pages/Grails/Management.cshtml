@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Grails.ManagementModel
@attribute [Authorize(Policy = "Observer")]

<link rel="stylesheet" href="~/css/General.css" />

<h1>Статистика граалей</h1>
<p>
    @if (User.IsInRole("Admin") || User.IsInRole("GrailsEditor"))
    {
        <a asp-page="/Grails/Create">Добавить данные о граале</a> <span>|</span>
    }

    <a asp-page="/Grails/Advices">Совет?</a> | <a asp-page="/Grails/General">Общая статистика по граалям</a>
</p>

<div class="stats-container">
    <div class="card">
        <div class="table-container @(User.IsInRole("Admin") ? "admin-user" : "") @(User.IsInRole("SaltsEditor") ? "editor-user" : "")">
            <table class="table-zebra">
                <thead>
                    <tr>
                        <th>Координаты</th>
                        <th>Ник</th>
                        <th>Часов</th>
                        <th>Дата</th>
                        @if (User.IsInRole("Admin") || User.IsInRole("SaltsEditor"))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <th data-role="admin">Добавлено</th>
                                <th data-role="admin">Редактировано</th>
                            }

                            <th data-role="admin">Действия</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grail in Model.Grails.Items)
                    {
                        <tr>
                            <td><b>@grail.HorizontalPosition-@grail.VerticalPosition</b></td>
                            <td><a asp-page="/Players/Details" asp-route-id="@grail.PlayerId">@grail.PlayerEntity.PName</a></td>
                            <td>@grail.HoursForPlayer</td>
                            <td>@grail.DateGrail</td>
                            @if (User.IsInRole("Admin") || User.IsInRole("SaltsEditor"))
                            {
                                @if (User.IsInRole("Admin"))
                                {
                                    <td data-role="admin">@grail.CreatorLoginEntity.Email</td>
                                    <td data-role="admin">@(grail.EditorId != null ? grail.EditorLoginEntity.Email : "")</td>
                                }

                                <td data-role="admin">
                                    <a asp-page="/Grails/Edit" asp-route-id="@grail.Id" class="btn btn-primary">Редактировать</a> |
                                    <form method="post" asp-page-handler="Delete" style="display:inline;">
                                        <input type="hidden" name="id" value="@grail.Id" />
                                        <button type="submit" class="btn btn-danger" onclick="return confirm('Вы уверены, что хотите удалить запись?')">Удалить</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <div class="pagination">
                @if (Model.Grails.HasPreviousPage)
                {
                    <a asp-page="/Grails/Management" asp-route-pageIndex="@(Model.Grails.PageIndex - 1)" class="btn btn-primary">&laquo; Назад</a>
                }
                else
                {
                    <span class="btn btn-primary disabled">&laquo; Назад</span>
                }

                @for (int i = 1; i <= Model.Grails.TotalPages; i++)
                {
                    if (i == Model.Grails.PageIndex)
                    {
                        <span class="btn btn-primary disabled">@i</span>
                    }
                    else
                    {
                        <a asp-page="/Grails/Management" asp-route-pageIndex="@i" class="btn btn-primary">@i</a>
                    }
                }

                @if (Model.Grails.HasNextPage)
                {
                    <a asp-page="/Grails/Management" asp-route-pageIndex="@(Model.Grails.PageIndex + 1)" class="btn btn-primary">Вперёд &raquo;</a>
                }
                else
                {
                    <span class="btn btn-primary disabled">Вперёд &raquo;</span>
                }
            </div>
        </div>
    </div>
</div>
<p><a asp-page="/Grails/General">Назад</a></p>