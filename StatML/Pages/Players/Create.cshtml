@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Players.CreateModel
@attribute [Authorize(Policy = "AdminOnly")]

<head>
    <link rel="stylesheet" href="~/css/General.css" />
</head>

<body>
    <h1>Добавить игрока</h1>

    <form method="post">
        <div class="form-group">
            <label asp-for="Player.PName">Имя</label>
            <input asp-for="Player.PName" class="form-control" />
            <span asp-validation-for="Player.PName" class="text-danger"></span>
            <label asp-for="Player.HorizontalPosition">Горизонтальная позиция</label>
            <input asp-for="Player.HorizontalPosition" class="form-control" />
            <span asp-validation-for="Player.HorizontalPosition" class="text-danger"></span>
            <label asp-for="Player.VerticalPosition">Вертикальная позиция</label>
            <input asp-for="Player.VerticalPosition" class="form-control" />
            <span asp-validation-for="Player.VerticalPosition" class="text-danger"></span>
            <label asp-for="Player.Clan">Клан</label>
            <input asp-for="Player.Clan" class="form-control" />
            <span asp-validation-for="Player.Clan" class="text-danger"></span>
            <label asp-for="Player.PercentSaltsGrails">Положенный процент</label>
            <input asp-for="Player.PercentSaltsGrails" class="form-control" />
            <span asp-validation-for="Player.PercentSaltsGrails" class="text-danger"></span>
            <input type="checkbox" asp-for="Player.IsGeneral" />
            <label asp-for="Player.IsGeneral">В распределении?</label>
            <span asp-validation-for="Player.IsGeneral" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a asp-page="/Players/Management" class="btn btn-secondary">Отмена</a>
    </form>
</body>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}