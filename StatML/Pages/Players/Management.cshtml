@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Players.ManagementModel
@attribute [Authorize(Policy = "Observer")]

@{
    // <head>
    //     <link rel="stylesheet" href="~/css/General.css" />
    // </head>

    // <body>
        <h1>Список игроков</h1>
        @if (User.IsInRole("Admin"))
        {
            <p>
                <a asp-page="/Players/Create">Добавить нового игрока</a> <span> | </span>
                <a asp-page="/FarmZones/Crossing">Показать пересечения</a>
            </p>
        }
            
        <div class="stats-container">
            <div class="card">
                <table class="table-zebra">
                    <thead>
                        <tr>
                            <th style="width:170px">Игровой ник</th>
                            <th style="width:150px">Столица</th>
                            <th style="width:170px">В распределении?</th>
                            <th>Фарм-зона</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th>Действия</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Model.Players.Items)
                        {
                            var playerFarmZones = Model.FarmZones.Where(x => x.PlayerId == player.Id).ToList();
                            var farmZoneList = playerFarmZones.Select(x => $"{x.HorizontalPosition}-{x.VerticalPosition}").ToList();

                            // Столица игрока
                            var capital = player.HorizontalPosition != null && player.VerticalPosition != null
                            ? $"{player.HorizontalPosition}-{player.VerticalPosition}"
                            : "—";

                            // Количество ВСЕХ фарм-зон
                            var totalZones = playerFarmZones.Count;

                            // Полный список
                            var fullList = string.Join(", ", farmZoneList);

                                <tr>
                                    <td><a asp-page="/Players/Details" asp-route-id="@player.Id">@player.PName</a></td>
                                    <td>@player.HorizontalPosition-@player.VerticalPosition</td>
                                    <td><input type="checkbox" checked="@player.IsGeneral" disabled="disabled" /></td>
                                <td class="farm-zone-cell">
                                    @if (totalZones > 0)
                                    {
                                        <div class="zone-preview">
                                            <span class="main-zone">@capital</span>
                                            <span class="extra-count">+@totalZones</span>
                                        </div>

                                        <div class="farm-tooltip">
                                            <div class="tooltip-content">@fullList</div>
                                            <div class="tooltip-arrow"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-zone">—</span>
                                    }
                                </td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td>
                                            <a asp-page="/Players/Edit" asp-route-id="@player.Id">Редактировать</a> |
                                            <a asp-page="/FarmZones/Edit" asp-route-id="@player.Id">ФЗ</a> |
                                            <form method="post" asp-page-handler="Delete" style="display:inline;">
                                                <input type="hidden" name="id" value="@player.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Вы уверены, что хотите удалить игрока @player.PName?')">Удалить</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                    </tbody>
                </table>

                <div class="pagination">
                    @if (Model.Players.HasPreviousPage)
                    {
                        <a asp-page="/Players/Management" asp-route-pageIndex="@(Model.Players.PageIndex - 1)" class="btn btn-primary">&laquo; Назад</a>
                    }
                    else
                    {
                        <span class="btn btn-primary disabled">&laquo; Назад</span>
                    }

                    @for (int i = 1; i <= Model.Players.TotalPages; i++)
                    {
                        if (i == Model.Players.PageIndex)
                        {
                            <span class="btn btn-primary disabled">@i</span>
                        }
                        else
                        {
                            <a asp-page="/Players/Management" asp-route-pageIndex="@i" class="btn btn-primary">@i</a>
                        }
                    }

                    @if (Model.Players.HasNextPage)
                    {
                        <a asp-page="/Players/Management" asp-route-pageIndex="@(Model.Players.PageIndex + 1)" class="btn btn-primary">Вперёд &raquo;</a>
                    }
                    else
                    {
                        <span class="btn btn-primary disabled">Вперёд &raquo;</span>
                    }
                </div>
            </div>
        </div>
        <p><a asp-page="/Index">Назад</a></p>
        
    // </body>
}


