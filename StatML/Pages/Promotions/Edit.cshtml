@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Promotions.EditModel
@attribute [Authorize(Policy = "AdminOnly")]

<head>
    <link rel="stylesheet" href="~/css/General.css" />
</head>

<body>
    <h1>Редактировать акцию</h1>
    <form method="post">
        <div class="form-group">
            <input type="hidden" asp-for="Promotion.Id" />
            <label asp-for="Promotion.DateOnly">Дата</label>
            <input asp-for="Promotion.DateOnly" value="@(Model.Promotion.DateOnly == default ? "" : Model.Promotion.DateOnly.ToString("yyyy-MM-dd"))" class="form-control" />
            <span asp-validation-for="Promotion.DateOnly" class="text-danger"></span>
            <label asp-for="Promotion.Level">Уровень</label>
            <input asp-for="Promotion.Level" class="form-control" />
            <span asp-validation-for="Promotion.Level" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a asp-page="/Index" class="btn btn-secondary">Отмена</a>
    </form>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}