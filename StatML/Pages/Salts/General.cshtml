@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Salts.GeneralModel
@attribute [Authorize(Policy = "Observer")]

<head>
    <link rel="stylesheet" href="~/css/General.css" />
</head>

<body>
    <h1>Общая статистика по озерам</h1>
    <p>
        <a asp-page="/Grails/GeneralSaltsGrails">Сводная статистика</a> | <a asp-page="/Salts/CurrentSaltsManagement">Управление</a>
    </p>
    <div class="stats-container">
        <div class="card">
            <table class="table-zebra">
                <thead>
                    <tr>
                        <th>Ник</th>
                        <th>Количество озер</th>
                        <th>Количество дней</th>
                        <th>Количество ЧЖ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in Model.Players.Items)
                    {
                        <tr>
                            <td><a asp-page="/Players/Details" asp-route-id="@player.Id">@player.PName</a></td>
                            <td>@player.SaltEntities.Count</td>
                            <td>@((int)player.SaltEntities.Sum(x => x.DaysForPlayer))</td>
                            <td><b>@((int)Math.Round(player.SaltEntities.Sum(x => x.DaysForPlayer) * 24 * 20))</b></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="pagination">
                @if (Model.Players.HasPreviousPage)
                {
                    <a asp-page="/Salts/General" " asp-route-pageIndex="@(Model.Players.PageIndex - 1)" class="btn btn-primary">&laquo; Назад</a>
                }
                else
                {
                    <span class="btn btn-primary disabled">&laquo; Назад</span>
                }

                @for (int i = 1; i <= Model.Players.TotalPages; i++)
                {
                    if (i == Model.Players.PageIndex)
                    {
                        <span class="btn btn-primary disabled">@i</span>
                    }
                    else
                    {
                        <a asp-page="/Salts/General" asp-route-pageIndex="@i" class="btn btn-primary">@i</a>
                    }
                }

                @if (Model.Players.HasNextPage)
                {
                    <a asp-page="/Salts/General" asp-route-pageIndex="@(Model.Players.PageIndex + 1)" class="btn btn-primary">Вперёд &raquo;</a>
                }
                else
                {
                    <span class="btn btn-primary disabled">Вперёд &raquo;</span>
                }
            </div>
        </div>
     </div>
    <p><a asp-page="/Index">Назад</a></p>
</body>




