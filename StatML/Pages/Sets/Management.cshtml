@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Sets.ManagementModel
@attribute [Authorize(Policy = "AdminOnly")]

<head>
    <link rel="stylesheet" href="~/css/General.css" />
</head>
<body>
    <h1>Управление комплектами</h1>
    <p>
        <a asp-page="/Sets/Create">Добавить комплект</a>
    </p>

    <div class="stats-container">
        <div class="card">
            <table class="table">
                <thead>
                    <tr>
                        <th>Назавание</th>
                        <th>Уровень</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sett in Model.Sets.Items)
                    {
                        <tr>
                            <td>@sett.Name</td>
                            <td>@sett.Level</td>
                            <td>
                                <a asp-page="/Sets/Edit" asp-route-id="@sett.Id">Редактировать</a> |
                                <form method="post" asp-page-handler="Delete" style="display:inline;">
                                    <input type="hidden" name="id" value="@sett.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Вы уверены, что хотите удалить запись?')">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="pagination">
                @if (Model.Sets.HasPreviousPage)
                {
                    <a asp-page="/Sets/Management" " asp-route-pageIndex="@(Model.Sets.PageIndex - 1)" class="btn btn-primary">&laquo; Назад</a>
                }
                else
                {
                    <span class="btn btn-primary disabled">&laquo; Назад</span>
                }

                @for (int i = 1; i <= Model.Sets.TotalPages; i++)
                {
                    if (i == Model.Sets.PageIndex)
                    {
                        <span class="btn btn-primary disabled">@i</span>
                    }
                    else
                    {
                        <a asp-page="/Sets/Management" asp-route-pageIndex="@i" class="btn btn-primary">@i</a>
                    }
                }

                @if (Model.Sets.HasNextPage)
                {
                    <a asp-page="/Sets/Management" asp-route-pageIndex="@(Model.Sets.PageIndex + 1)" class="btn btn-primary">Вперёд &raquo;</a>
                }
                else
                {
                    <span class="btn btn-primary disabled">Вперёд &raquo;</span>
                }
            </div>
        </div>
    </div>
    <p><a asp-page="/Index">Назад</a></p>
</body>
