@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Tournaments.DetailsForTournamentsModel
@attribute [Authorize(Policy = "Everyone")]

<link rel="stylesheet" href="~/css/General.css" />

<h1>Управление турнирами</h1>

<div class="stats-container">
    <div class="card">
        <table class="table-zebra">
            <thead>
                <tr>
                    <th>Турнир</th>
                    <th>Дата</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tournament in Model.TournamentsDates.Items)
                {
                    <tr data-date="@tournament">
                        <td></td>
                        <td><a asp-page="/Tournaments/Details" asp-route-id="@tournament">@tournament</a></td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination">
            @if (Model.TournamentsDates.HasPreviousPage)
            {
                <a asp-page="/Tournaments/Details" asp-route-pageIndex="@(Model.TournamentsDates.PageIndex - 1)" class="btn btn-primary">&laquo; Назад</a>
            }
            else
            {
                <span class="btn btn-primary disabled">&laquo; Назад</span>
            }

            @for (int i = 1; i <= Model.TournamentsDates.TotalPages; i++)
            {
                if (i == Model.TournamentsDates.PageIndex)
                {
                    <span class="btn btn-primary disabled">@i</span>
                }
                else
                {
                    <a asp-page="/Tournaments/Details" asp-route-pageIndex="@i" class="btn btn-primary">@i</a>
                }
            }

            @if (Model.TournamentsDates.HasNextPage)
            {
                <a asp-page="/Tournaments/Details" asp-route-pageIndex="@(Model.TournamentsDates.PageIndex + 1)" class="btn btn-primary">Вперёд &raquo;</a>
            }
            else
            {
                <span class="btn btn-primary disabled">Вперёд &raquo;</span>
            }
        </div>
    </div>
</div>
<p><a asp-page="/Index">Назад</a></p>

@section Scripts {
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', () => {
            const rows = document.querySelectorAll('.table tbody tr');
            const dateMap = new Map();
            let colorIndex = 0;

            // Сбор уникальных дат
            rows.forEach(row => {
                const dateCell = row.querySelector('td:nth-child(6)');
                const date = dateCell ? dateCell.textContent.trim() : '';
                if (date && !dateMap.has(date)) {
                    dateMap.set(date, colorIndex % 2 === 0 ? '#FFFFFF' : '#E0F7FA');
                    colorIndex++;
                }
                if (date) {
                    row.style.backgroundColor = dateMap.get(date);
                }
            });
        });
    </script>
}