@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Tournaments.EditModel
@attribute [Authorize(Policy = "TournamentsEditor")]

<link rel="stylesheet" href="~/css/General.css" />

<h1>Редактировать данные о турнире</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Tournament.TournamentTypeId">Тип турнира</label>
        <select asp-for="Tournament.TournamentTypeId" asp-items="Model.TypesOfTournaments" class="form-control">
            <option value="">-- Выберите тип турнира --</option>
        </select>
        <span asp-validation-for="Tournament.TournamentTypeId" class="text-danger"></span>

        <input type="hidden" asp-for="Tournament.Id" />

        <label asp-for="Tournament.PlayerId">Участник</label>
        <select asp-for="Tournament.PlayerId" asp-items="Model.Players" class="form-control">
            <option value="">-- Выберите игрока --</option>
        </select>
        <span asp-validation-for="Tournament.PlayerId" class="text-danger"></span>

        <label asp-for="Tournament.ArtifactId">Артефакт</label>
        <select asp-for="Tournament.ArtifactId" asp-items="Model.Artifacts" class="form-control">
            <option value="">-- Выберите артефакт --</option>
        </select>
        <span asp-validation-for="Tournament.ArtifactId" class="text-danger"></span>

        <label asp-for="Tournament.DateOnly">Дата турнира</label>
        <input asp-for="Tournament.DateOnly" value="@(Model.Tournament.DateOnly == default ? "" : Model.Tournament.DateOnly.ToString("yyyy-MM-dd"))" class="form-control" />
        <span asp-validation-for="Tournament.DateOnly" class="text-danger"></span>

        <label asp-for="Tournament.PositionInTournament">Позиция в турнире</label>
        <input asp-for="Tournament.PositionInTournament" class="form-control" />
        <span asp-validation-for="Tournament.PositionInTournament" class="text-danger"></span>

        <label asp-for="Tournament.CountOfPoints">Количество очков</label>
        <input asp-for="Tournament.CountOfPoints" class="form-control" />
        <span asp-validation-for="Tournament.CountOfPoints" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="/Index" class="btn btn-secondary">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}