@page
@using Microsoft.AspNetCore.Authorization
@model StatML.Pages.Tournaments.ManagementModel
@attribute [Authorize(Policy = "Everyone")]

<link rel="stylesheet" href="~/css/General.css" />

<h1>Управление турнирами</h1>
<p>
    @if (User.IsInRole("Admin") || User.IsInRole("TournamentsEditor"))
    {
        <a asp-page="/Tournaments/Create">Добавить турнир</a> <span> | </span>
    }

    <a asp-page="/Tournaments/Details">Сдача флагов</a>
</p>

<div class="stats-container">
    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 120px;">Игрок</th>
                    <th style="width: 120px;">Турнир</th>
                    <th style="width: 100px;">Позиция</th>
                    <th style="width: 100px;">Очки</th>
                    <th>Артефакт</th>
                    <th style="width: 120px;">Дата</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("TournamentsEditor"))
                    {
                        <th>Действия</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var tournament in Model.Tournaments.Items)
                {
                    var artifactName = tournament.ArtifactEntity != null ? tournament.ArtifactEntity.Name : "Артефакт не указан";
                    var setName = tournament.ArtifactEntity != null && tournament.ArtifactEntity.SetEntity != null ? tournament.ArtifactEntity.SetEntity.Name : "";
                    var setLevel = tournament.ArtifactEntity != null && tournament.ArtifactEntity.SetEntity != null ? tournament.ArtifactEntity.SetEntity?.Level.ToString() : "0";

                    <tr data-date="@tournament.DateOnly">
                        <td style="width: 120px;"><a asp-page="/Players/Details" asp-route-id="@tournament.PlayerEntity.Id">@tournament.PlayerEntity.PName</a></td>
                        <td style="width: 120px;"><a asp-page="/Tournaments/Details" asp-route-id="@tournament.TournamentTypeEntity.Id">@tournament.TournamentTypeEntity.TypeName</a></td>
                        <td style="width: 100px;">@tournament.PositionInTournament</td>
                        <td style="width: 100px;">@tournament.CountOfPoints</td>
                        <td>@( $"{artifactName} ({setName}[{setLevel} Ур.])")</td>
                        <td style="width: 120px;">@tournament.DateOnly</td>
                        @if (User.IsInRole("Admin") || User.IsInRole("TournamentsEditor"))
                        {
                            <td>
                                <a asp-page="/Tournaments/Edit" asp-route-id="@(tournament?.Id ?? 0)">Редактировать</a> |
                                <form method="post" asp-page-handler="Delete" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@(tournament?.Id ?? 0)" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Вы уверены, что хотите удалить запись?')">Удалить</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination">
            @if (Model.Tournaments.HasPreviousPage)
            {
                <a asp-page="/Tournaments/Management" asp-route-pageIndex="@(Model.Tournaments.PageIndex - 1)" class="btn btn-primary">&laquo; Назад</a>
            }
            else
            {
                <span class="btn btn-primary disabled">&laquo; Назад</span>
            }

            @for (int i = 1; i <= Model.Tournaments.TotalPages; i++)
            {
                if (i == Model.Tournaments.PageIndex)
                {
                    <span class="btn btn-primary disabled">@i</span>
                }
                else
                {
                    <a asp-page="/Tournaments/Management" asp-route-pageIndex="@i" class="btn btn-primary">@i</a>
                }
            }

            @if (Model.Tournaments.HasNextPage)
            {
                <a asp-page="/Tournaments/Management" asp-route-pageIndex="@(Model.Tournaments.PageIndex + 1)" class="btn btn-primary">Вперёд &raquo;</a>
            }
            else
            {
                <span class="btn btn-primary disabled">Вперёд &raquo;</span>
            }
        </div>
    </div>
</div>
<p><a asp-page="/Index">Назад</a></p>

@section Scripts {
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', () => {
            const rows = document.querySelectorAll('.table tbody tr');
            const dateMap = new Map();
            let colorIndex = 0;

            // Сбор уникальных дат
            rows.forEach(row => {
                const dateCell = row.querySelector('td:nth-child(6)');
                if (dateCell) {
                    const date = dateCell.textContent.trim();
                    if (!dateMap.has(date)) {
                        dateMap.set(date, colorIndex % 2 === 0 ? '#FFFFFF' : '#E0F7FA');
                        colorIndex++;
                    }
                    row.style.backgroundColor = dateMap.get(date);
                }
            });
        });
    </script>
}